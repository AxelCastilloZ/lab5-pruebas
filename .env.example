# Copiar a .env para el login local. No subir .env a Git.
# Dejar AUTH0_DOMAIN y AUTH0_CLIENT_ID vacios para que el chat quede abierto en pruebas.

AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
APP_BASE_URL=http://localhost:3000

# URI de Postgres para el rol una_chat_backend. TLS obligatorio.
# Host directo (IPv6): postgresql://una_chat_backend:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=verify-full
# Session pooler (IPv4): postgresql://una_chat_backend.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres?sslmode=verify-full
VAULT_DATABASE_URL=

# Opcional: secreto para firmar la cookie de sesion.
SESSION_SECRET=

# No definir AUTH0_CLIENT_SECRET. El backend lee
# una_chat_auth0_client_secret desde Supabase Vault al arrancar.
